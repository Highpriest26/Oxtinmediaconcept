# Public site URL used for canonical links and Open Graph metadata
NEXT_PUBLIC_SITE_URL="https://oxtinmediaconcept.com"

# Enquiry submission delivery provider
# Options:
#  - leave empty / unset: forms safely return a helpful NOT_CONFIGURED status (never fakes success)
#  - "webhook": forwards JSON payload to ENQUIRY_WEBHOOK_URL
ENQUIRY_PROVIDER=""
ENQUIRY_WEBHOOK_URL=""
ENQUIRY_WEBHOOK_SECRET=""
